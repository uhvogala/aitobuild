// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/azure-cli:1": {
		}
	},
	"mounts": [
		"source=aitobuild-azure-auth,target=/home/vscode/.azure,type=volume"
	],
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"containerEnv": {
		"AITOBUILD_DEVELOPER_SESSION_CONTAINER_BIND_PATH": "${localWorkspaceFolder}"
	},
	"remoteEnv": {
		"VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
		"PATH": "${containerWorkspaceFolder}/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
		"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
		"CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"GIT_SSL_CAINFO": "/etc/ssl/certs/ca-certificates.crt"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"terminal.integrated.env.linux": {
					"VIRTUAL_ENV": "${workspaceFolder}/.venv",
					"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
				}
			}
		}
	}

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

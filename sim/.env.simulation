# Local simulation environment for aitobuild (safe defaults).
# This file is intended for local development only.

AITOBUILD_WEBHOOK_SECRET=sim-webhook-secret
AITOBUILD_REQUIRE_INTERNAL_AUTH=true
AITOBUILD_INTERNAL_API_TOKEN=sim-internal-token

AITOBUILD_ALLOW_MOCK_MODEL=true
AITOBUILD_FOUNDRY_MODEL=gpt-4.1

AITOBUILD_SCHEDULER_ENABLED=true
AITOBUILD_SCHEDULER_KILL_SWITCH=false
AITOBUILD_ARCHITECT_SCAN_CRON=0 8 * * *
AITOBUILD_MEETING_TICK_CRON=*/30 * * * *
AITOBUILD_MAX_PROACTIVE_JOBS=2

AITOBUILD_REQUIRE_APPROVAL_FOR_REPO_WRITES=true
AITOBUILD_REQUIRE_DEVELOPER_PREVIEW=true
AITOBUILD_DEVELOPER_EXECUTION_MODE=subprocess
AITOBUILD_DEVELOPER_COMMAND_TIMEOUT_SECONDS=120

AITOBUILD_DEVELOPER_SESSION_CONTAINER_IMAGE=python:3.14-slim
AITOBUILD_DEVELOPER_SESSION_CONTAINER_WORKDIR=/workspace
AITOBUILD_DEVELOPER_SESSION_CONTAINER_PREFIX=aitobuild-sim
AITOBUILD_DEVELOPER_SESSION_RUN_AS_CURRENT_USER=true

AITOBUILD_DEVELOPER_ENABLE_MCP_ADAPTERS=false
AITOBUILD_DEVELOPER_MCP_SHELL_TOOL_NAME=execute_command
AITOBUILD_DEVELOPER_MCP_FILESYSTEM_READ_TOOL_NAME=read_file
AITOBUILD_DEVELOPER_MCP_FILESYSTEM_WRITE_TOOL_NAME=write_file
